# ==============================================================================
# CODING THUNDER — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' before running the application:
#   Windows:     Copy-Item .env.example .env
#   Linux/macOS: cp .env.example .env
#
# Each setting below includes its requirement status, default behavior,
# purpose, and an example format.
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & SECURITY
# ------------------------------------------------------------------------------

# [Required] Secret cryptographic key used by Flask to sign session cookies.
# Default: None (Application will fail to maintain authenticated sessions without this)
# Generate a random string (e.g. using `python -c "import secrets; print(secrets.token_hex(32))"`)
FLASK_SECRET_KEY=paste-your-generated-secret-key-here

# [Required] Switch between local development and cloud production.
# Required Value: "True" for local development; "False" for production.
# Default: None
# Note: When "True", uses `local_uri` and maps post image column to "img_file".
#       When "False", uses `prod_uri` and maps post image column to "image_url".
local_server=True


# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (SQLAlchemy)
# ------------------------------------------------------------------------------

# [Conditional] Local database connection URI.
# Required if: local_server=True
# Default: None
# Format: mysql+mysqldb://<username>:<password>@<host>:<port>/<dbname>
local_uri=mysql://root:@localhost/codingthunder

# [Conditional] Production database connection URI.
# Required if: local_server=False
# Default: None
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname> (e.g. Supabase Postgres URI)
prod_uri=postgresql://postgres:your-db-password@db.your-supabase-id.supabase.co:5432/postgres


# ------------------------------------------------------------------------------
# 3. ADMINISTRATIVE AUTHENTICATION
# ------------------------------------------------------------------------------

# [Required] Username for administrator login at /dashboard
# Default: None
admin_user=admin

# [Required] Password for administrator login at /dashboard
# Default: None
admin_password=create_your_secure_password_here


# ------------------------------------------------------------------------------
# 4. SUPABASE CLOUD OBJECT STORAGE
# ------------------------------------------------------------------------------
# Coding Thunder uses Supabase Storage to store uploaded post images in a public
# bucket named 'Images'. Create this bucket in your Supabase dashboard.

# [Required] Base API URL of your Supabase project.
# Default: None
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# [Required] Supabase public/anon or service API key for uploading to storage.
# Default: None
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here


# ------------------------------------------------------------------------------
# 5. BLOG BRANDING & CONTENT SETTINGS
# ------------------------------------------------------------------------------

# [Required] Site name rendered in headers, navigation, and footer.
# Default: None
blog_name=Coding Thunder

# [Required] Subtitle rendered on the homepage hero banner.
# Default: None
tag_line=A Blog liked by programmers

# [Required] Biographical content rendered on the /about page.
# Default: None
about_text=Welcome to Coding Thunder! A platform dedicated to high-performance engineering insights, software architecture, and developer resources.

# [Required] Number of articles displayed per page on the homepage before pagination.
# Default: Must be a valid integer (e.g. 2, 5, 10)
no_of_posts=5

# [Optional] Local directory path for file uploads.
# Default: None (Images are streamed to Supabase Cloud Storage)
upload_location=static/assets/img

# [Optional] Avatar or logo URL displayed on the admin login modal.
# Default: None (Falls back to empty / local image)
login_image=https://your-bucket.supabase.co/storage/v1/object/public/Images/admin_avatar.png


# ------------------------------------------------------------------------------
# 6. MASTHEAD BACKGROUND IMAGES (HERO BANNERS)
# ------------------------------------------------------------------------------
# Provide full URLs (e.g. Supabase CDN URLs or external image URLs).
# Default: If omitted or empty, each page automatically falls back to 'static/assets/img/post_back.jpg'.

# [Optional] Homepage masthead hero background image URL.
# Default: static/assets/img/post_back.jpg
INDEX_BG=https://your-bucket.supabase.co/storage/v1/object/public/Images/index_bg.jpg

# [Optional] About page masthead hero background image URL.
# Default: static/assets/img/post_back.jpg
ABOUT_BG=https://your-bucket.supabase.co/storage/v1/object/public/Images/about_bg.jpg

# [Optional] Contact page masthead hero background image URL.
# Default: static/assets/img/post_back.jpg
CONTACT_BG=https://your-bucket.supabase.co/storage/v1/object/public/Images/contact_bg.jpg

# [Optional] Admin Dashboard masthead hero background image URL.
# Default: static/assets/img/post_back.jpg
DASHBOARD_BG=https://your-bucket.supabase.co/storage/v1/object/public/Images/dashboard_bg.jpg

# [Optional] Post Editor masthead hero background image URL.
# Default: static/assets/img/post_back.jpg
EDIT_BG=https://your-bucket.supabase.co/storage/v1/object/public/Images/edit_bg.jpg


# ------------------------------------------------------------------------------
# 7. SOCIAL MEDIA FOOTER LINKS
# ------------------------------------------------------------------------------
# Default: If omitted or empty, links render without a target destination.

# [Optional] Facebook profile or page URL.
fb_url=https://facebook.com/codingthunder

# [Optional] Twitter/X profile URL.
tw_url=https://twitter.com/codingthunder

# [Optional] GitHub repository or profile URL.
gh_url=https://github.com/varkush123/webproject


# ------------------------------------------------------------------------------
# 8. CONTACT FORM EMAIL SERVICE (WEBHOOK)
# ------------------------------------------------------------------------------
# Contact submissions are saved to the 'Contacts' database table and then forwarded
# via HTTP POST to an external Google Apps Script web app endpoint.

# [Optional] Google Apps Script Web App deployment URL.
# Default: None (If omitted, contact messages will be saved to the database but no email dispatched)
EMAIL_SERVICE_URL=https://script.google.com/macros/s/your-google-apps-script-deployment-id/exec

# [Optional] Secret authentication token verified by your Google Apps Script handler.
# Default: None
EMAIL_SERVICE_TOKEN=your-secret-webhook-token


# ------------------------------------------------------------------------------
# 9. SERVER SELF-PING & KEEP-ALIVE (OPTIONAL)
# ------------------------------------------------------------------------------
# Background scheduler parameters to prevent sleeping on free-tier cloud hosts (e.g. Render).

# [Optional] Enable or disable the periodic self-ping job ("true" or "false").
# Default: "true"
ENABLE_SELF_PING=true

# [Optional] Public base URL of your deployed application (e.g. on Render/Railway).
# Default: None (If omitted, self-ping is automatically disabled)
APP_URL=https://your-app.onrender.com

# [Optional] Fallback direct ping endpoint.
# Default: None
SERVER_PING_URL=https://your-app.onrender.com/hello

# [Optional] Interval in minutes between self-ping requests.
# Default: 10
PING_INTERVAL_MINUTES=10